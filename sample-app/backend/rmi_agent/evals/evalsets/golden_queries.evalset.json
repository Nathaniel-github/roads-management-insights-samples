[
  {
    "eval_id": "data_scientist_outlier_detection",
    "prompt": "Which travel time records for route 'route-4202493217' are statistical outliers, defined as being beyond 1.5 * IQR of duration? Expected columns: record_time, duration_in_seconds.",
    "sql": [
      "WITH stats AS (",
      "  SELECT",
      "    APPROX_QUANTILES(duration_in_seconds, 100)[OFFSET(25)] AS q1,",
      "    APPROX_QUANTILES(duration_in_seconds, 100)[OFFSET(75)] AS q3",
      "  FROM `boston_oct_2025_sample_data.historical_travel_time`",
      "  WHERE selected_route_id = 'route-4202493217'",
      "),",
      "bounds AS (",
      "  SELECT",
      "    q1 - 1.5 * (q3 - q1) AS lower_bound,",
      "    q3 + 1.5 * (q3 - q1) AS upper_bound",
      "  FROM stats",
      ")",
      "SELECT",
      "  h.record_time,",
      "  h.duration_in_seconds",
      "FROM `boston_oct_2025_sample_data.historical_travel_time` h",
      "CROSS JOIN bounds b",
      "WHERE h.selected_route_id = 'route-4202493217'",
      "  AND (h.duration_in_seconds < b.lower_bound OR h.duration_in_seconds > b.upper_bound)",
      "ORDER BY h.record_time DESC;"
    ],
    "dataset_id": "boston_oct_2025_sample_data",
    "tags": [
      "data_scientist",
      "sql_data_eval"
    ],
    "autorater": "sql_data"
  },
  {
    "eval_id": "data_scientist_feature_engineering",
    "prompt": "For route 'route-4202493217', generate an hourly feature set including average duration, 1-hour and 2-hour lagged durations, and a 3-hour rolling average duration. Ensure hour gaps are filled. Expected columns: hour, avg_duration, lagged_duration_1h, lagged_duration_2h, rolling_avg_duration_3h.",
    "sql": [
      "WITH hourly_avg AS (",
      "  SELECT",
      "    TIMESTAMP_TRUNC(record_time, HOUR) as record_hour,",
      "    AVG(duration_in_seconds) as avg_duration",
      "  FROM `boston_oct_2025_sample_data.historical_travel_time`",
      "  WHERE selected_route_id = 'route-4202493217'",
      "  GROUP BY 1",
      "),",
      "bounds AS (",
      "  SELECT MIN(record_hour) AS min_h, MAX(record_hour) AS max_h FROM hourly_avg",
      "),",
      "time_grid AS (",
      "  SELECT hour",
      "  FROM bounds, UNNEST(GENERATE_TIMESTAMP_ARRAY(min_h, max_h, INTERVAL 1 HOUR)) as hour",
      "),",
      "regularized AS (",
      "  SELECT",
      "    g.hour,",
      "    a.avg_duration",
      "  FROM time_grid g",
      "  LEFT JOIN hourly_avg a ON g.hour = a.record_hour",
      ")",
      "SELECT",
      "  hour,",
      "  avg_duration,",
      "  LAG(avg_duration, 1) OVER (ORDER BY hour) AS lagged_duration_1h,",
      "  LAG(avg_duration, 2) OVER (ORDER BY hour) AS lagged_duration_2h,",
      "  AVG(avg_duration) OVER (ORDER BY hour ROWS BETWEEN 2 PRECEDING AND CURRENT ROW) AS rolling_avg_duration_3h",
      "FROM regularized",
      "ORDER BY hour DESC;"
    ],
    "dataset_id": "boston_oct_2025_sample_data",
    "tags": [
      "data_scientist",
      "sql_data_eval"
    ],
    "autorater": "sql_data"
  },
  {
    "eval_id": "data_scientist_route_integrity_audit",
    "prompt": "Identify streaks where active routes experienced extreme geometry deviations (actual length differing from intended length by more than 10%). Return the start, end, and duration of these streaks. Expected columns: selected_route_id, display_name, streak_start, streak_end, streak_duration_seconds.",
    "sql": [
      "WITH base_comparison AS (",
      "  SELECT",
      "    h.selected_route_id,",
      "    h.display_name,",
      "    h.record_time,",
      "    ST_LENGTH(h.route_geometry) AS actual_length,",
      "    CAST(JSON_VALUE(s.route_attributes, '$.route_length') AS FLOAT64) AS intended_length",
      "  FROM `boston_oct_2025_sample_data.historical_travel_time` h",
      "  JOIN `boston_oct_2025_sample_data.routes_status` s USING (selected_route_id)",
      "  WHERE s.status = 'STATUS_RUNNING'",
      "),",
      "outlier_flagging AS (",
      "  SELECT",
      "    *,",
      "    IF(intended_length IS NOT NULL AND (SAFE_DIVIDE(actual_length, intended_length) > 1.1 OR SAFE_DIVIDE(actual_length, intended_length) < 0.9), 1, 0) as is_outlier",
      "  FROM base_comparison",
      "),",
      "streak_identification AS (",
      "  SELECT",
      "    *,",
      "    IF(is_outlier = 1 AND LAG(is_outlier) OVER (PARTITION BY selected_route_id ORDER BY record_time) = 0, 1,",
      "       IF(is_outlier = 1 AND LAG(is_outlier) OVER (PARTITION BY selected_route_id ORDER BY record_time) IS NULL, 1, 0)) as is_streak_start",
      "  FROM outlier_flagging",
      "),",
      "streak_grouping AS (",
      "  SELECT",
      "    *,",
      "    SUM(is_streak_start) OVER (PARTITION BY selected_route_id ORDER BY record_time) as streak_id",
      "  FROM streak_identification",
      "  WHERE is_outlier = 1",
      ")",
      "SELECT",
      "  selected_route_id,",
      "  display_name,",
      "  MIN(record_time) as streak_start,",
      "  MAX(record_time) as streak_end,",
      "  TIMESTAMP_DIFF(MAX(record_time), MIN(record_time), SECOND) as streak_duration_seconds",
      "FROM streak_grouping",
      "GROUP BY selected_route_id, display_name, streak_id",
      "ORDER BY streak_start DESC;"
    ],
    "dataset_id": "boston_oct_2025_sample_data",
    "tags": [
      "data_scientist",
      "sql_data_eval"
    ],
    "autorater": "sql_data"
  },
  {
    "eval_id": "data_scientist_reliability_ranking",
    "prompt": "Identify streaks of 3 or more sample periods where routes experienced persistent travel time spikes (actual duration > 1.5 * static duration). Return the start, end, and average delay ratio. Expected columns: selected_route_id, incident_start, incident_end, avg_delay_ratio.",
    "sql": [
      "WITH incident_flagging AS (",
      "  SELECT",
      "    selected_route_id,",
      "    record_time,",
      "    duration_in_seconds,",
      "    static_duration_in_seconds,",
      "    IF(SAFE_DIVIDE(duration_in_seconds, static_duration_in_seconds) > 1.5, 1, 0) as is_incident",
      "  FROM `boston_oct_2025_sample_data.historical_travel_time`",
      "),",
      "streak_identification AS (",
      "  SELECT",
      "    *,",
      "    IF(is_incident = 1 AND LAG(is_incident) OVER (PARTITION BY selected_route_id ORDER BY record_time) = 0, 1,",
      "       IF(is_incident = 1 AND LAG(is_incident) OVER (PARTITION BY selected_route_id ORDER BY record_time) IS NULL, 1, 0)) as is_streak_start",
      "  FROM incident_flagging",
      "),",
      "streak_grouping AS (",
      "  SELECT",
      "    *,",
      "    SUM(is_streak_start) OVER (PARTITION BY selected_route_id ORDER BY record_time) as streak_id",
      "  FROM streak_identification",
      "  WHERE is_incident = 1",
      ")",
      "SELECT",
      "  selected_route_id,",
      "  MIN(record_time) as incident_start,",
      "  MAX(record_time) as incident_end,",
      "  AVG(SAFE_DIVIDE(duration_in_seconds, static_duration_in_seconds)) as avg_delay_ratio",
      "FROM streak_grouping",
      "GROUP BY selected_route_id, streak_id",
      "HAVING COUNT(*) >= 3",
      "ORDER BY avg_delay_ratio DESC, incident_start DESC;"
    ],
    "dataset_id": "boston_oct_2025_sample_data",
    "tags": [
      "data_scientist",
      "sql_data_eval"
    ],
    "autorater": "sql_data"
  },
  {
    "eval_id": "data_scientist_zero_shot_forecasting",
    "prompt": "Forecast the next 24 hours of hourly traffic duration for routes 'route-4202493217', 'route-3850158153', and 'route-381361371' using the TimesFM 2.0 model. Expected columns: selected_route_id, forecast_timestamp, forecast_value, confidence_level, prediction_interval_lower_bound, prediction_interval_upper_bound, ai_forecast_status.",
    "sql": [
      "WITH route_context AS (",
      "  SELECT",
      "    selected_route_id,",
      "    TIMESTAMP_TRUNC(record_time, HOUR) as record_hour,",
      "    AVG(duration_in_seconds) as duration_in_seconds",
      "  FROM `boston_oct_2025_sample_data.historical_travel_time`",
      "  WHERE selected_route_id IN ('route-4202493217', 'route-3850158153', 'route-381361371')",
      "    AND record_time BETWEEN '2025-10-14' AND '2025-10-21'",
      "  GROUP BY 1, 2",
      ")",
      "SELECT",
      "  *",
      "FROM AI.FORECAST(",
      "  TABLE route_context,",
      "  data_col => 'duration_in_seconds',",
      "  timestamp_col => 'record_hour',",
      "  model => 'TimesFM 2.0',",
      "  id_cols => ['selected_route_id'],",
      "  horizon => 24,",
      "  confidence_level => 0.9",
      ")",
      "ORDER BY selected_route_id, forecast_timestamp;"
    ],
    "dataset_id": "boston_oct_2025_sample_data",
    "tags": [
      "data_scientist",
      "sql_data_eval"
    ],
    "autorater": "sql_data"
  },
  {
    "eval_id": "rmi_planner_usage_projection",
    "prompt": "What is the average number of historical travel time records per route per day? Scale this to estimate total daily and monthly records (in millions,assume 30 days) for 5,000 routes. Expected columns: avg_records_per_route_per_day, estimated_total_daily_records, estimated_monthly_millions.",
    "sql": [
      "WITH daily_stats AS (",
      "  SELECT",
      "    DATE(record_time) as log_date,",
      "    selected_route_id,",
      "    COUNT(*) as records_per_day",
      "  FROM `boston_oct_2025_sample_data.historical_travel_time`",
      "  GROUP BY 1, 2",
      "),",
      "avg_usage AS (",
      "  SELECT",
      "    AVG(records_per_day) as avg_daily_records_per_route",
      "  FROM daily_stats",
      ")",
      "SELECT",
      "  avg_daily_records_per_route as avg_records_per_route_per_day,",
      "  avg_daily_records_per_route * 5000 as estimated_total_daily_records,",
      "  avg_daily_records_per_route * 5000 * 30 / 1000000 as estimated_monthly_millions",
      "FROM avg_usage;"
    ],
    "dataset_id": "boston_oct_2025_sample_data",
    "tags": [
      "rmi_planner",
      "sql_data_eval"
    ],
    "autorater": "sql_data"
  },
  {
    "eval_id": "rmi_planner_customer_roi",
    "prompt": "Calculate total delay hours and average delay index aggregated by route status, considering only records where actual duration exceeds static duration. Expected columns: status, total_delay_hours, avg_delay_index.",
    "sql": [
      "SELECT",
      "  s.status,",
      "  SUM(duration_in_seconds - static_duration_in_seconds) / 3600 as total_delay_hours,",
      "  AVG(SAFE_DIVIDE(duration_in_seconds, static_duration_in_seconds)) as avg_delay_index",
      "FROM `boston_oct_2025_sample_data.historical_travel_time` h",
      "JOIN `boston_oct_2025_sample_data.routes_status` s ON h.selected_route_id = s.selected_route_id",
      "WHERE (duration_in_seconds - static_duration_in_seconds) > 0",
      "GROUP BY s.status;"
    ],
    "dataset_id": "boston_oct_2025_sample_data",
    "tags": [
      "rmi_planner",
      "sql_data_eval"
    ],
    "autorater": "sql_data"
  },
  {
    "eval_id": "traffic_operations_manager_peak_hour_delay",
    "prompt": "What is the average delay ratio during the morning peak (7-9 AM ET) for the top 10 most congested active routes with a delay ratio greater than 1.0? Expected columns: selected_route_id, avg_delay_ratio.",
    "sql": [
      "WITH peak_hour_data AS (",
      "  SELECT",
      "    h.selected_route_id,",
      "    h.display_name,",
      "    SAFE_DIVIDE(h.duration_in_seconds, h.static_duration_in_seconds) AS delay_ratio",
      "  FROM `boston_oct_2025_sample_data.historical_travel_time` AS h",
      "  JOIN `boston_oct_2025_sample_data.routes_status` AS s USING (selected_route_id)",
      "  WHERE s.status = 'STATUS_RUNNING'",
      "    AND EXTRACT(HOUR FROM DATETIME(h.record_time, 'America/New_York')) >= 7",
      "    AND EXTRACT(HOUR FROM DATETIME(h.record_time, 'America/New_York')) < 9",
      ")",
      "SELECT",
      "  selected_route_id,",
      "  AVG(delay_ratio) AS avg_delay_ratio",
      "FROM peak_hour_data",
      "GROUP BY 1",
      "HAVING avg_delay_ratio > 1.0",
      "ORDER BY avg_delay_ratio DESC",
      "LIMIT 10;"
    ],
    "dataset_id": "boston_oct_2025_sample_data",
    "tags": [
      "traffic_operations_manager",
      "sql_data_eval"
    ],
    "autorater": "sql_data"
  },
  {
    "eval_id": "traffic_operations_manager_persistent_bottlenecks",
    "prompt": "Which routes have the highest count of 'TRAFFIC_JAM' speed reading intervals? Return the top 10. Expected columns: selected_route_id, traffic_jam_count.",
    "sql": [
      "WITH exploded_sris AS (",
      "  SELECT",
      "    selected_route_id,",
      "    sri.speed",
      "  FROM `boston_oct_2025_sample_data.recent_roads_data`,",
      "  UNNEST(speed_reading_intervals) AS sri",
      ")",
      "SELECT",
      "  selected_route_id,",
      "  COUNT(*) AS traffic_jam_count",
      "FROM exploded_sris",
      "WHERE speed = 'TRAFFIC_JAM'",
      "GROUP BY selected_route_id",
      "ORDER BY traffic_jam_count DESC",
      "LIMIT 10;"
    ],
    "dataset_id": "boston_oct_2025_sample_data",
    "tags": [
      "traffic_operations_manager",
      "sql_data_eval"
    ],
    "autorater": "sql_data"
  },
  {
    "eval_id": "traffic_operations_manager_significant_event_detection",
    "prompt": "Which active routes experienced a travel time more than double their static baseline between 2025-10-30 and 2025-11-01 (excluding Nov 1)? Expected columns: display_name, selected_route_id, record_time, duration_in_seconds, static_duration_in_seconds, delay_ratio.",
    "sql": [
      "SELECT",
      "  h.display_name,",
      "  h.selected_route_id,",
      "  h.record_time,",
      "  h.duration_in_seconds,",
      "  h.static_duration_in_seconds,",
      "  SAFE_DIVIDE(h.duration_in_seconds, h.static_duration_in_seconds) AS delay_ratio",
      "FROM `boston_oct_2025_sample_data.historical_travel_time` AS h",
      "JOIN `boston_oct_2025_sample_data.routes_status` AS s USING(selected_route_id)",
      "WHERE h.record_time >= '2025-10-30' AND h.record_time < '2025-11-01'",
      "  AND s.status = 'STATUS_RUNNING'",
      "  AND SAFE_DIVIDE(h.duration_in_seconds, h.static_duration_in_seconds) > 2.0",
      "ORDER BY delay_ratio DESC;"
    ],
    "dataset_id": "boston_oct_2025_sample_data",
    "tags": [
      "traffic_operations_manager",
      "sql_data_eval"
    ],
    "autorater": "sql_data"
  },
  {
    "eval_id": "urban_planner_corridor_trend",
    "prompt": "What is the week-over-week trend in the average delay ratio for route 'route-4202493217'? Expected columns: selected_route_id, year_week, avg_delay_ratio.",
    "sql": [
      "WITH weekly_trends AS (",
      "  SELECT",
      "    selected_route_id,",
      "    TIMESTAMP_TRUNC(record_time, WEEK) AS week,",
      "    AVG(SAFE_DIVIDE(duration_in_seconds, static_duration_in_seconds)) AS avg_delay_ratio",
      "  FROM `boston_oct_2025_sample_data.historical_travel_time`",
      "  WHERE selected_route_id = 'route-4202493217'",
      "  GROUP BY 1, 2",
      ")",
      "SELECT",
      "  selected_route_id,",
      "  FORMAT_TIMESTAMP(\"%Y-%W\", week) AS year_week,",
      "  avg_delay_ratio AS avg_delay_ratio",
      "FROM weekly_trends",
      "ORDER BY week;"
    ],
    "dataset_id": "boston_oct_2025_sample_data",
    "tags": [
      "urban_planner",
      "sql_data_eval"
    ],
    "autorater": "sql_data"
  },
  {
    "eval_id": "urban_planner_weekend_vs_weekday",
    "prompt": "How does average travel time in the afternoon (2-5 PM ET) differ between weekdays and weekends in terms of delay ratio and duration? Expected columns: day_type, avg_delay_ratio, avg_duration_seconds.",
    "sql": [
      "WITH afternoon_stats AS (",
      "  SELECT",
      "    CASE",
      "      WHEN EXTRACT(DAYOFWEEK FROM DATETIME(record_time, 'America/New_York')) IN (1, 7) THEN 'Weekend'",
      "      ELSE 'Weekday'",
      "    END AS day_type,",
      "    duration_in_seconds,",
      "    static_duration_in_seconds",
      "  FROM `boston_oct_2025_sample_data.historical_travel_time`",
      "  WHERE EXTRACT(HOUR FROM DATETIME(record_time, 'America/New_York')) >= 14",
      "    AND EXTRACT(HOUR FROM DATETIME(record_time, 'America/New_York')) < 17",
      ")",
      "SELECT",
      "  day_type,",
      "  AVG(SAFE_DIVIDE(duration_in_seconds, static_duration_in_seconds)) AS avg_delay_ratio,",
      "  AVG(duration_in_seconds) AS avg_duration_seconds",
      "FROM afternoon_stats",
      "GROUP BY 1",
      "ORDER BY avg_delay_ratio DESC;"
    ],
    "dataset_id": "boston_oct_2025_sample_data",
    "tags": [
      "urban_planner",
      "sql_data_eval"
    ],
    "autorater": "sql_data"
  }
]